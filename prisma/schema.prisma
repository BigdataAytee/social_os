// SocialOS — Prisma schema
// Companion to ARCHITECTURE.md §4-5. Every business table carries orgId and is
// always queried scoped to the authenticated user's organization (never trust
// a client-supplied orgId — derive it from the session in the service layer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase serves the app through the pooler (pgbouncer), which can't run
  // migrations. DIRECT_URL is the unpooled connection used by `prisma migrate`.
  // For a plain local Postgres, set both to the same value. See ARCHITECTURE.md §11.
  directUrl = env("DIRECT_URL")
}

// ============================= ENUMS =============================

enum Platform {
  X
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE
}

enum PostStatus {
  DRAFT
  NEEDS_APPROVAL
  SCHEDULED
  QUEUED
  PUBLISHED
  FAILED
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  /// Writes and edits, but never submits for approval — a contractor or
  /// freelancer whose work an EDITOR or above shepherds through the gate.
  CREATOR
  VIEWER
  /// Deny-by-default (OS-ARCHITECTURE.md §9). A client reviews and approves
  /// their own workspace's work and can see nothing else. This is the one
  /// failure an agency cannot survive, so CLIENT gets an explicit allow-list
  /// rather than inheriting VIEWER's.
  CLIENT
}

/// What kind of workspace an Organization is (OS-ARCHITECTURE.md §11 stage 3).
///
/// The Organization already *was* the workspace: it carries every business row,
/// isolation is enforced in the service layer and covered by the smoke suite,
/// and the schema already allowed a user to hold several memberships. A separate
/// Workspace table inside Organization — which the architecture doc sketched —
/// would have duplicated a boundary that already works and required backfilling
/// a workspaceId onto sixteen tables. What was actually missing was switching
/// between them, two roles, and branding.
enum OrgKind {
  /// A brand running its own accounts. The default, and what every existing
  /// organization is.
  BRAND
  /// A client workspace owned by an agency, reachable from its parent.
  CLIENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

/// Where a unit of background work is in its lifecycle
/// (OS-ARCHITECTURE.md §4, §11 stage 1).
enum JobStatus {
  PENDING
  CLAIMED
  DONE
  FAILED
  /// Out of attempts. Kept, never deleted — a job that gave up is the most
  /// interesting row in the table and deleting it hides the outage.
  DEAD
}

enum ConnectedAccountStatus {
  MOCK // default in v1 — see modules/integrations
  CONNECTED
  ERROR
  DISCONNECTED
}

/// Which implementation of PlatformAdapter answers for an account
/// (Platform-Connections.md §4). Null while status is MOCK.
///
/// Stored per account rather than chosen globally: that is the whole point —
/// X on DIRECT because its per-call cost is worth paying, while TikTok, Meta
/// and YouTube stay on UNIFIED to skip the review queues, is four rows with one
/// field set differently, not a fork in the codebase.
enum IntegrationMode {
  DIRECT
  UNIFIED
}

// ======================= CORE / TENANCY =======================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  kind        OrgKind  @default(BRAND)
  /// Set on a CLIENT workspace: the agency that owns it. An agency's admins can
  /// reach their clients' workspaces; nothing else crosses the line.
  parentOrgId String?
  /// White-label surface: logo, accent, report footer. Display only — never
  /// anything that decides access.
  branding    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Organization?  @relation("AgencyClients", fields: [parentOrgId], references: [id], onDelete: SetNull)
  children Organization[] @relation("AgencyClients")

  memberships             Membership[]
  connectedAccounts       ConnectedAccount[]
  externalPosts           ExternalPost[]
  trendEvents             TrendEvent[]
  jobs                    Job[]
  brandProfile            BrandProfile?
  memoryChunks            MemoryChunk[]
  conversations           Conversation[]
  monitors                Monitor[]
  xPosts                  XPost[]
  xStories                XStory[]
  xSuggestions            XSuggestion[]
  strategyRecommendations StrategyRecommendation[]
  posts                   Post[]
  campaigns               Campaign[]
  ideas                   Idea[]
  assets                  Asset[]
  folders                 Folder[]
  competitors             Competitor[]
  brandVoice              BrandVoice?
  aiGenerations           AIGeneration[]
  notifications           Notification[]
  tasks                   Task[]
  comments                Comment[]
  activityLogs            ActivityLog[]

  @@index([parentOrgId])
  @@map("organizations")
}

model User {
  id        String   @id // matches Supabase auth.uid()
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships           Membership[]
  postsAuthored         Post[]         @relation("PostAuthor")
  tasksAssigned         Task[]         @relation("TaskAssignee")
  conversationsAssigned Conversation[] @relation("ConversationAssignee")
  comments              Comment[]
  aiGenerations         AIGeneration[]
  activityLogs          ActivityLog[]

  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

// =============== PLATFORM INTEGRATION (mock-first) ===============
// See ARCHITECTURE.md §10 — status defaults to MOCK until a real adapter
// is wired; UI never needs to know the difference.

model ConnectedAccount {
  id              String                 @id @default(cuid())
  orgId           String
  platform        Platform
  handle          String
  status          ConnectedAccountStatus @default(MOCK)
  /// Null while status is MOCK; set the moment a real connection is made
  /// (Platform-Connections.md §3). Every service-layer call resolves its adapter
  /// with getAdapter(account.platform, account.integrationMode).
  integrationMode IntegrationMode?
  meta            Json? // adapter-specific display fields only — never store raw tokens here
  /// IANA zone, e.g. "Africa/Lagos". Null means UTC.
  ///
  /// Not cosmetic: best-posting-times bucketed published posts by their **UTC**
  /// hour and then displayed the number bare, so "post at 14:00" meant 14:00
  /// UTC to everyone. For an account whose audience is anywhere else that
  /// recommendation was simply wrong.
  timezone        String?
  /// ISO 3166-1 alpha-2, e.g. "NG". Null means worldwide.
  /// Scopes trend discovery — a trending topic is a local fact.
  region          String?
  /// BCP-47, e.g. "en-GB". Null means the brand voice decides.
  /// Passed to generation so drafts come back in the audience's language.
  language        String?
  /// Last successful pull from the platform API. Null means never synced.
  lastSyncAt      DateTime?
  /// Why the last sync failed, if it did. Cleared on the next success.
  lastSyncError   String?
  /// Why the last *successful* sync found nothing.
  ///
  /// Distinct from lastSyncError on purpose. A sync that completes and returns
  /// zero rows is not a failure, but it is indistinguishable from one to
  /// somebody looking at an empty Studio — and the usual cause is a real
  /// limitation they had no way to guess. A note keeps lastSyncError meaning
  /// "something broke" while still explaining the silence.
  lastSyncNote    String?
  createdAt       DateTime               @default(now())

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  snapshots     AnalyticsSnapshot[]
  credential    PlatformCredential?
  externalPosts ExternalPost[]
  conversations Conversation[]

  @@unique([orgId, platform, handle])
  @@index([orgId])
  @@map("connected_accounts")
}

/// OAuth tokens for a ConnectedAccount, encrypted at rest.
///
/// DEVIATION from Platform-Connections.md §3, deliberate and kept.
/// That section sketches `accessTokenEnc` / `refreshTokenEnc` as two independent
/// encrypted columns. This table stores one AES-256-GCM envelope over both
/// instead, because GCM needs a unique IV *and* an authentication tag per
/// encryption — the two-column sketch has nowhere to put either, and dropping
/// the tag would mean a tampered row decrypts to plausible garbage that then
/// gets sent to a platform API as a bearer credential. Two separately sealed
/// columns would need four more columns for no benefit, since the pair is
/// always read together. §3's actual requirements are all met: one dedicated
/// tightly-scoped table, column-level encryption, key held outside the database,
/// and read from exactly one place (modules/integrations/oauth/service.ts).
///
/// `externalId` and `scopes` are additions §3 doesn't mention: the platform's
/// own account id is needed in every API path, and the granted scope set can be
/// narrower than the requested one.
///
/// A separate table rather than columns on ConnectedAccount because
/// ARCHITECTURE.md §10 reserves `meta` for display fields and forbids tokens
/// anywhere on that row. Keeping them apart also means every ordinary account
/// read — the Studio header, the analytics page, the account picker — never
/// loads ciphertext, and disconnecting is a delete here rather than a
/// nullable-column dance on a row other things reference.
///
/// `ciphertext` is AES-256-GCM over a JSON envelope holding the access token and
/// (when the platform issues one) the refresh token. See lib/crypto.ts.
model PlatformCredential {
  accountId  String    @id
  /// Base64 AES-256-GCM ciphertext of { accessToken, refreshToken }.
  ciphertext String
  /// Base64 initialisation vector, unique per encryption.
  iv         String
  /// Base64 GCM authentication tag — detects tampering on decrypt.
  authTag    String
  /// When the access token expires. Null for platforms that issue non-expiring
  /// tokens. The refresh happens ahead of this, not on a 401.
  expiresAt  DateTime?
  /// Scopes actually granted, which can be narrower than those requested.
  scopes     String[]
  /// The platform's own id for the account, used in its API paths.
  externalId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("platform_credentials")
}

/// A post pulled from a connected platform, with the metrics that platform
/// reports for it.
///
/// Deliberately not the `Post` table: `Post` is content authored in SocialOS and
/// carries an author, a status and an approval history. These are read-only
/// observations of what already went out — including posts published long before
/// this org existed — and they exist so insights can analyse real performance
/// per post rather than only the daily rollups in AnalyticsSnapshot.
model ExternalPost {
  id          String   @id @default(cuid())
  orgId       String
  accountId   String
  /// The platform's id for this post. Unique per account, and what makes a
  /// re-sync an update rather than a duplicate.
  externalId  String
  permalink   String?
  text        String
  /// "video" | "image" | "carousel" | "text" — normalised across platforms so
  /// format analysis can compare like with like.
  mediaType   String
  publishedAt DateTime
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  views       Int      @default(0)
  /// Metrics the platform reports that don't map onto the four above —
  /// saves, watch time, click-throughs. Display and analysis only.
  metrics     Json     @default("{}")
  fetchedAt   DateTime @default(now())

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([orgId, publishedAt])
  @@map("external_posts")
}

// ======================= TRENDS (fan-out pipeline) =======================
// Platform-Native-Studios.md §2 — one detected trend, fanned out through five
// prompt templates that each already know their platform's native shape.

model TrendEvent {
  id         String   @id @default(cuid())
  orgId      String
  topic      String
  summary    String
  sourceUrl  String?
  /// "breaking" | "rising" | "steady" — decides how fast a response is worth
  /// drafting at all.
  velocity   String
  /// "quick-hit" | "explainer-worthy" — decides Shorts vs long-form on YouTube,
  /// and single post vs carousel elsewhere.
  depth      String
  detectedAt DateTime @default(now())

  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  responses TrendResponse[]

  @@index([orgId, detectedAt])
  @@map("trend_events")
}

model TrendResponse {
  id           String   @id @default(cuid())
  trendEventId String
  platform     Platform
  /// Set once the draft is reviewed and saved as a real Post. Null means the
  /// draft was generated but never accepted — the pipeline auto-drafts, it
  /// never auto-publishes.
  draftPostId  String?
  createdAt    DateTime @default(now())

  trendEvent TrendEvent @relation(fields: [trendEventId], references: [id], onDelete: Cascade)

  @@map("trend_responses")
}

// ==================== GROWTH STRATEGIST ENGINE ====================
// Growth-Strategist-Engine.md §4. Statistics plus one LLM synthesis step, not a
// trained model — a recompute pipeline, not a training pipeline.

model StrategyRecommendation {
  id                 String   @id @default(cuid())
  orgId              String
  platform           Platform
  /// "best-time" | "content-type-ranking" | "weekly-briefing"
  type               String
  payload            Json
  /// "low" | "medium" | "high" — driven by sample size, not vibes. Cold-start
  /// rows fall back to benchmarks.json and are always "low".
  confidence         String
  /// Timestamp of the freshest data point this used, so the UI can say "based
  /// on data through <date>" rather than implying real-time omniscience.
  basedOnDataThrough DateTime
  generatedAt        DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, platform, type])
  @@map("strategy_recommendations")
}

// ==================== BRAND BRAIN & MEMORY ====================
// OS-ARCHITECTURE.md §11 stage 4. "The AI gets smarter over time" means
// retrieval and recompute over the org's own data — not training. A new org has
// no proprietary training data on day one and standing up training
// infrastructure for that would be disproportionate. Nothing here fine-tunes
// anything, and no copy should imply otherwise.

/// The voice profile SocialOS *learned*, as opposed to the one you declared.
///
/// `BrandVoice` is hand-authored: what you say you sound like. This is
/// extracted from what you actually published and which of it worked. They are
/// deliberately separate rows — when they disagree, that disagreement is
/// information, and merging them would destroy it.
model BrandProfile {
  orgId          String   @id
  /// Words and phrases this org uses far more than baseline, with counts.
  vocabulary     Json     @default("{}")
  /// Sentence length, paragraph shape, question rate.
  sentenceStats  Json     @default("{}")
  /// Emoji per post, observed rather than declared.
  emojiRate      Float    @default(0)
  /// Opening lines of posts that outperformed, as patterns to reuse.
  hookPatterns   Json     @default("[]")
  /// Recurring subjects, derived from term frequency across the corpus.
  contentPillars Json     @default("[]")
  /// platformData.kind values that beat this org's average.
  winningFormats Json     @default("[]")
  /// How many posts this was derived from. Zero means nothing was learned yet,
  /// and the profile must not be fed to the model as if it had been.
  basedOnPosts   Int      @default(0)
  updatedAt      DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
}

/// One retrievable piece of the org's own history.
///
/// Deliberately lexical, not vector. Embeddings would need an embeddings
/// provider this stack doesn't have, and a `vector` column nothing can populate
/// is worse than honest full-text search: it looks like a working feature.
/// Postgres full-text over an org's own few thousand posts is genuinely good,
/// and the upgrade path is one added column plus a backfill job.
model MemoryChunk {
  id         String   @id @default(cuid())
  orgId      String
  /// "post" | "external-post" | "generation" | "idea" | "briefing"
  sourceType String
  sourceId   String
  text       String
  metadata   Json     @default("{}")
  /// Engagement rate where the source had one, so recall can prefer what
  /// actually worked rather than merely what matched.
  score      Float?
  createdAt  DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sourceType, sourceId])
  @@index([orgId, sourceType])
  @@map("memory_chunks")
}

// ==================== UNIFIED ENGAGEMENT INBOX ====================
// OS-ARCHITECTURE.md §11 stage 5. Comments, mentions and DMs from every
// platform in one queue, because a social media manager's day is spent in five
// browser tabs and the tabs are the product problem.

/// A comment thread, a mention, or a DM — the same object, because triage
/// treats them identically. What differs is only where the reply goes, and that
/// is the adapter's problem.
enum ConversationKind {
  COMMENT
  MENTION
  DM
}

enum ConversationStatus {
  OPEN
  SNOOZED
  DONE
}

/// Coarse on purpose. A five-point scale invites arguing about whether
/// something is a 2 or a 3; three buckets are what triage actually uses.
enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model Conversation {
  id            String             @id @default(cuid())
  orgId         String
  accountId     String
  platform      Platform
  kind          ConversationKind
  /// The platform's id for the thread this belongs to — a post id for comments,
  /// a conversation id for DMs. Unique per account, and what makes a re-sync an
  /// update rather than a duplicate.
  externalId    String
  /// The person on the other side, as the platform names them.
  authorHandle  String
  authorName    String?
  permalink     String?
  status        ConversationStatus @default(OPEN)
  /// Who on the team owns this. Null means nobody has picked it up.
  assigneeId    String?
  sentiment     Sentiment          @default(NEUTRAL)
  /// 0–100, derived rather than entered. See modules/inbox/triage.ts for what
  /// feeds it and why each factor is there.
  priority      Int                @default(0)
  /// Set when status is SNOOZED — the moment it should come back.
  snoozeUntil   DateTime?
  /// Denormalised so the list can sort without joining every message.
  lastMessageAt DateTime
  /// Inbound messages nobody has read. Reset when the thread is opened.
  unread        Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account  ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignee User?            @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages InboxMessage[]

  @@unique([accountId, externalId])
  @@index([orgId, status, lastMessageAt])
  @@index([orgId, assigneeId])
  @@map("conversations")
}

model InboxMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// The platform's id. Null for a reply we sent that the platform hasn't
  /// acknowledged with one yet.
  externalId     String?
  /// True for anything we sent. The only field triage actually branches on.
  outbound       Boolean  @default(false)
  authorHandle   String
  text           String
  /// Who sent it, when it was us. Null for inbound, and for replies sent by an
  /// automation rather than a person.
  sentById       String?
  sentAt         DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId, sentAt])
  @@map("inbox_messages")
}

// ==================== X HUB INTELLIGENCE ENGINE ====================
// X-HUB.md. A discovery surface over public X content: replies worth reading,
// news assembled from evidence, gists, trends, viral video.
//
// The content source is a seam, not an assumption — see X-HUB.md §1. Every
// table here is agnostic about whether a row arrived from X's API, a
// third-party aggregator, or the mock.

enum XStoryKind {
  /// A post and the reply that outdid it.
  SAVAGE
  /// Several posts assembled into a written story with evidence.
  NEWS
  /// A story-style summary of a trending conversation.
  GIST
  /// A trending topic, explained.
  TREND
  /// A video that travelled.
  VIDEO
  /// A creator worth watching.
  CREATOR
}

/// Why a post is attached to a story. Drives layout as much as meaning: a NEWS
/// story renders EVIDENCE as a strip, a SAVAGE story renders ORIGINAL above
/// REPLY.
enum XPostRole {
  ORIGINAL
  REPLY
  EVIDENCE
}

/// One public X post, cached.
///
/// Cached rather than fetched per render because every module reads the same
/// posts and the source is rate-limited and — on the tiers that support search —
/// billed per call. This is also what makes dedupe possible: the same tweet
/// surfacing in a trend and a news story is one row.
model XPost {
  id              String   @id @default(cuid())
  orgId           String
  /// X's own id. Unique per org, which is what makes a re-pull an update.
  externalId      String
  authorHandle    String
  authorName      String?
  authorAvatarUrl String?
  authorVerified  Boolean  @default(false)
  text            String
  /// The thread this belongs to, as X reports it. Null when unknown.
  conversationId  String?
  /// The post this replies to, when it is a reply.
  replyToId       String?
  permalink       String?
  /// "video" | "image" | "carousel" | "text" — the same four values
  /// ExternalPost uses, so format analysis can compare across both.
  mediaType       String   @default("text")
  mediaUrls       String[]
  likes           Int      @default(0)
  replies         Int      @default(0)
  reposts         Int      @default(0)
  views           Int      @default(0)
  publishedAt     DateTime
  fetchedAt       DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stories XStoryPost[]

  @@unique([orgId, externalId])
  @@index([orgId, publishedAt])
  @@index([orgId, conversationId])
  @@map("x_posts")
}

model XStory {
  id        String     @id @default(cuid())
  orgId     String
  kind      XStoryKind
  /// Headline. AI-written for NEWS and GIST, derived for the rest.
  title     String
  /// The written story, or the explanation of why a topic trends.
  summary   String?
  /// Cover image, when the story has one — the first evidence post's media.
  coverUrl  String?
  /// Subjects this story is about, for dedupe and filtering.
  topics    String[]
  /// 0–100. How this story ranks against the others on the hub.
  score     Int        @default(0)
  /// Component scores, kept so a card can show *why* it ranked. Null members
  /// mean that signal wasn't available — see X-HUB.md §3.
  scoring   Json       @default("{}")
  /// Module-specific payload: a gist's hashtags and poll, a news story's
  /// timeline, a trend's meme ideas. Kept apart from `scoring` because that
  /// field means one thing — how this ranked — and overloading it would make
  /// both unreadable.
  details   Json       @default("{}")
  saved     Boolean    @default(false)
  savedAt   DateTime?
  /// Which source produced it, for debugging a hub that looks wrong.
  source    String     @default("mock")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  posts XStoryPost[]

  @@index([orgId, kind, score])
  @@index([orgId, saved])
  @@map("x_stories")
}

model XStoryPost {
  id         String    @id @default(cuid())
  storyId    String
  postId     String
  role       XPostRole
  /// Order within the story — evidence strips and timelines are ordered.
  position   Int       @default(0)
  /// 0–100 each, for a REPLY. Humour and roast are null when no model was
  /// available; the ranking then runs on the arithmetic signals alone and says
  /// so, rather than pretending to have judged wit.
  humour     Int?
  roast      Int?
  virality   Int?
  engagement Int?

  story XStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  post  XPost  @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([storyId, postId])
  @@index([storyId, position])
  @@map("x_story_posts")
}

/// An AI-generated thing to post, per hub tab.
///
/// Separate from XStory because they answer different questions. A story is
/// *something that happened* — evidence, collected. A suggestion is *something
/// to do* — proposed, and either used or dismissed. Folding them together would
/// mean a feed where observations and proposals sit in one list, which is how a
/// person stops being able to tell what is real.
model XSuggestion {
  id        String     @id @default(cuid())
  orgId     String
  /// Which tab this belongs to.
  tab       XStoryKind
  title     String
  /// The suggestion itself — the caption, the meme concept, the thread outline.
  body      String
  /// Why it was suggested. Grounded in rows where there are rows, and honest
  /// about being a cold start where there are not.
  why       String
  /// Label for the accept button: "Use this meme", "Use trend".
  cta       String     @default("Use this")
  /// Anything the accept action needs — hashtags, a format, a source post id.
  payload   Json       @default("{}")
  /// Set when someone acted on it, so the next batch doesn't repeat it.
  usedAt    DateTime?
  dismissed Boolean    @default(false)
  createdAt DateTime   @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, tab, createdAt])
  @@map("x_suggestions")
}

// ======================= BACKGROUND WORK =======================
// OS-ARCHITECTURE.md §11 stage 1. Nothing continuous could exist before this:
// one nightly cron was the whole of the app's ability to act on its own, which
// is why SCHEDULED posts never actually fired.

/// One unit of durable background work.
///
/// Deliberately a table rather than an external queue service. The work here is
/// minute-resolution (publish this post, sync this account, run this rule), the
/// database is already the source of truth, and a row that can be inspected in
/// psql beats an opaque queue when a customer's post didn't go out. The
/// `modules/jobs` interface is the seam that makes swapping to a real queue
/// cheap if sub-minute latency ever matters.
model Job {
  id             String    @id @default(cuid())
  orgId          String
  /// Which handler runs this — see modules/jobs/handlers.ts.
  kind           String
  payload        Json      @default("{}")
  status         JobStatus @default(PENDING)
  /// Not before this time. Backoff sets it forward on each retry.
  runAfter       DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  /// Set while a worker holds it. A claim older than the lease is reclaimable,
  /// which is what stops a crashed worker from stranding work forever.
  claimedAt      DateTime?
  lastError      String?
  /// Optional dedupe key: enqueuing the same key twice is a no-op while one is
  /// still pending. Stops a cron that runs twice from publishing twice.
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([status, runAfter])
  @@index([orgId, kind])
  @@map("jobs")
}

// ============================ CONTENT ============================

model Post {
  id           String     @id @default(cuid())
  orgId        String
  platform     Platform
  status       PostStatus @default(DRAFT)
  body         String
  platformData Json       @default("{}") // thread arrays, carousel slides, thumbnails — shape varies per platform
  campaignId   String?
  authorId     String
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign Campaign?    @relation(fields: [campaignId], references: [id])
  author   User         @relation("PostAuthor", fields: [authorId], references: [id])
  comments Comment[]

  @@index([orgId, platform, status])
  @@index([orgId, scheduledAt])
  @@map("posts")
}

model Campaign {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([orgId])
  @@map("campaigns")
}

model Idea {
  id        String   @id @default(cuid())
  orgId     String
  platform  Platform
  content   String
  source    String? // "manual" | "ai" | "swipe-file"
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, platform])
  @@map("ideas")
}

