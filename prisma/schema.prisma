// ========================= TEAM WORKSPACE =========================

model Task {
  id         String     @id @default(cuid())
  orgId      String
  title      String
  status     TaskStatus @default(TODO)
  assigneeId String?
  dueDate    DateTime?
  entityType String? // "post" | "campaign" — lightweight polymorphic link, enforced at app layer
  entityId   String?
  createdAt  DateTime   @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([orgId, status])
  @@map("tasks")
}

model Comment {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  body       String
  postId     String? // direct FK for the common case: comments on posts, for approvals
  entityType String? // "campaign" | other — polymorphic fallback, enforced at app layer
  entityId   String?
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])
  post Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([orgId, postId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String // recipient — soft reference, no FK needed for a notification feed
  type      String // "post-approved" | "mention" | "trend-alert" | ...
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, read])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  action     String // "post.published" | "member.invited" | ...
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@map("activity_logs")
}
