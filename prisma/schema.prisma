// SocialOS — Prisma schema
// Companion to ARCHITECTURE.md §4-5. Every business table carries orgId and is
// always queried scoped to the authenticated user's organization (never trust
// a client-supplied orgId — derive it from the session in the service layer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase serves the app through the pooler (pgbouncer), which can't run
  // migrations. DIRECT_URL is the unpooled connection used by `prisma migrate`.
  // For a plain local Postgres, set both to the same value. See ARCHITECTURE.md §11.
  directUrl = env("DIRECT_URL")
}

// ============================= ENUMS =============================

enum Platform {
  X
  TIKTOK
  INSTAGRAM
  FACEBOOK
  YOUTUBE
}

enum PostStatus {
  DRAFT
  NEEDS_APPROVAL
  SCHEDULED
  QUEUED
  PUBLISHED
  FAILED
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ConnectedAccountStatus {
  MOCK // default in v1 — see modules/integrations
  CONNECTED
  ERROR
  DISCONNECTED
}

// ======================= CORE / TENANCY =======================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  connectedAccounts ConnectedAccount[]
  externalPosts     ExternalPost[]
  posts             Post[]
  campaigns         Campaign[]
  ideas             Idea[]
  assets            Asset[]
  folders           Folder[]
  competitors       Competitor[]
  brandVoice        BrandVoice?
  aiGenerations     AIGeneration[]
  notifications     Notification[]
  tasks             Task[]
  comments          Comment[]
  activityLogs      ActivityLog[]

  @@map("organizations")
}

model User {
  id        String   @id // matches Supabase auth.uid()
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())

  memberships   Membership[]
  postsAuthored Post[]         @relation("PostAuthor")
  tasksAssigned Task[]         @relation("TaskAssignee")
  comments      Comment[]
  aiGenerations AIGeneration[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

// =============== PLATFORM INTEGRATION (mock-first) ===============
// See ARCHITECTURE.md §10 — status defaults to MOCK until a real adapter
// is wired; UI never needs to know the difference.

model ConnectedAccount {
  id            String                 @id @default(cuid())
  orgId         String
  platform      Platform
  handle        String
  status        ConnectedAccountStatus @default(MOCK)
  meta          Json? // adapter-specific display fields only — never store raw tokens here
  /// Last successful pull from the platform API. Null means never synced.
  lastSyncAt    DateTime?
  /// Why the last sync failed, if it did. Cleared on the next success.
  lastSyncError String?
  createdAt     DateTime               @default(now())

  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  snapshots     AnalyticsSnapshot[]
  credential    PlatformCredential?
  externalPosts ExternalPost[]

  @@unique([orgId, platform, handle])
  @@index([orgId])
  @@map("connected_accounts")
}

/// OAuth tokens for a ConnectedAccount, encrypted at rest.
///
/// A separate table rather than columns on ConnectedAccount because
/// ARCHITECTURE.md §10 reserves `meta` for display fields and forbids tokens
/// anywhere on that row. Keeping them apart also means every ordinary account
/// read — the Studio header, the analytics page, the account picker — never
/// loads ciphertext, and disconnecting is a delete here rather than a
/// nullable-column dance on a row other things reference.
///
/// `ciphertext` is AES-256-GCM over a JSON envelope holding the access token and
/// (when the platform issues one) the refresh token. See lib/crypto.ts.
model PlatformCredential {
  accountId  String    @id
  /// Base64 AES-256-GCM ciphertext of { accessToken, refreshToken }.
  ciphertext String
  /// Base64 initialisation vector, unique per encryption.
  iv         String
  /// Base64 GCM authentication tag — detects tampering on decrypt.
  authTag    String
  /// When the access token expires. Null for platforms that issue non-expiring
  /// tokens. The refresh happens ahead of this, not on a 401.
  expiresAt  DateTime?
  /// Scopes actually granted, which can be narrower than those requested.
  scopes     String[]
  /// The platform's own id for the account, used in its API paths.
  externalId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("platform_credentials")
}

/// A post pulled from a connected platform, with the metrics that platform
/// reports for it.
///
/// Deliberately not the `Post` table: `Post` is content authored in SocialOS and
/// carries an author, a status and an approval history. These are read-only
/// observations of what already went out — including posts published long before
/// this org existed — and they exist so insights can analyse real performance
/// per post rather than only the daily rollups in AnalyticsSnapshot.
model ExternalPost {
  id          String   @id @default(cuid())
  orgId       String
  accountId   String
  /// The platform's id for this post. Unique per account, and what makes a
  /// re-sync an update rather than a duplicate.
  externalId  String
  permalink   String?
  text        String
  /// "video" | "image" | "carousel" | "text" — normalised across platforms so
  /// format analysis can compare like with like.
  mediaType   String
  publishedAt DateTime
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  views       Int      @default(0)
  /// Metrics the platform reports that don't map onto the four above —
  /// saves, watch time, click-throughs. Display and analysis only.
  metrics     Json     @default("{}")
  fetchedAt   DateTime @default(now())

  org     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, externalId])
  @@index([orgId, publishedAt])
  @@map("external_posts")
}

// ============================ CONTENT ============================

model Post {
  id           String     @id @default(cuid())
  orgId        String
  platform     Platform
  status       PostStatus @default(DRAFT)
  body         String
  platformData Json       @default("{}") // thread arrays, carousel slides, thumbnails — shape varies per platform
  campaignId   String?
  authorId     String
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  campaign Campaign?    @relation(fields: [campaignId], references: [id])
  author   User         @relation("PostAuthor", fields: [authorId], references: [id])
  comments Comment[]

  @@index([orgId, platform, status])
  @@index([orgId, scheduledAt])
  @@map("posts")
}

model Campaign {
  id          String    @id @default(cuid())
  orgId       String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([orgId])
  @@map("campaigns")
}

model Idea {
  id        String   @id @default(cuid())
  orgId     String
  platform  Platform
  content   String
  source    String? // "manual" | "ai" | "swipe-file"
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, platform])
  @@map("ideas")
}

// ========================= ASSET LIBRARY =========================

model Folder {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Folder?      @relation("FolderChildren", fields: [parentId], references: [id])
  children Folder[]     @relation("FolderChildren")
  assets   Asset[]

  @@index([orgId])
  @@map("folders")
}

model Asset {
  id        String   @id @default(cuid())
  orgId     String
  type      String // "image" | "video" | "document" | "brand-asset"
  name      String
  url       String
  folderId  String?
  tags      String[]
  createdAt DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder Folder?      @relation(fields: [folderId], references: [id])

  @@index([orgId, folderId])
  @@map("assets")
}

// ======================= COMPETITIVE INTEL =======================

model Competitor {
  id        String   @id @default(cuid())
  orgId     String
  platform  Platform
  handle    String
  notes     String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, platform, handle])
  @@map("competitors")
}

// =========================== BRAND VOICE ===========================

model BrandVoice {
  orgId        String   @id // 1:1 with Organization, shared primary key
  tone         String
  audience     String
  emojiUsage   String // "none" | "light" | "heavy"
  ctaStyle     String
  readingLevel String
  avoidWords   String[]
  terminology  Json     @default("{}")
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("brand_voice")
}

// ============================ ANALYTICS ============================

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  accountId   String
  date        DateTime
  followers   Int
  reach       Int
  engagement  Int
  impressions Int
  clicks      Int      @default(0)

  account ConnectedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
  @@index([accountId, date])
  @@map("analytics_snapshots")
}

// =============================== AI ===============================

model AIGeneration {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  studio    Platform
  type      String // validated against lib/validators/ai.ts — see ARCHITECTURE.md §4 (deliberately not an enum)
  input     String
  output    String
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId, studio, type])
  @@map("ai_generations")
}

// ========================= TEAM WORKSPACE =========================

model Task {
  id         String     @id @default(cuid())
  orgId      String
  title      String
  status     TaskStatus @default(TODO)
  assigneeId String?
  dueDate    DateTime?
  entityType String? // "post" | "campaign" — lightweight polymorphic link, enforced at app layer
  entityId   String?
  createdAt  DateTime   @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([orgId, status])
  @@map("tasks")
}

model Comment {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  body       String
  postId     String? // direct FK for the common case: comments on posts, for approvals
  entityType String? // "campaign" | other — polymorphic fallback, enforced at app layer
  entityId   String?
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])
  post Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([orgId, postId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  orgId     String
  userId    String // recipient — soft reference, no FK needed for a notification feed
  type      String // "post-approved" | "mention" | "trend-alert" | ...
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, read])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  action     String // "post.published" | "member.invited" | ...
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@map("activity_logs")
}
