# ---------------------------------------------------------------------------
# SocialOS environment — see ARCHITECTURE.md §11
# Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Postgres. On Supabase these are the "Connection pooling" and "Direct
# connection" strings from Project Settings → Database.
# For a plain local Postgres, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialos"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/socialos"

# Supabase Auth — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional. Where new sign-ups land. Set to the seeded demo org's slug and anyone
# who signs up joins a workspace that already has data in it — the fastest way to
# see the app working. Leave empty and each new user gets their own empty
# workspace instead (the normal onboarding path).
SOCIALOS_JOIN_ORG_SLUG="northwind"

# Optional, server-only. Lets prisma/seed.ts create Supabase auth users for the
# five demo people so you can sign in as each role. Not needed if you just sign
# up yourself — SOCIALOS_JOIN_ORG_SLUG puts you in the same org.
SUPABASE_SERVICE_ROLE_KEY=""

# Password given to the seeded demo users. Optional.
SEED_DEMO_PASSWORD="socialos-demo-1234"

# AI orchestrator (ARCHITECTURE.md §9) — not used until Phase 2.
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Connected accounts (OAuth 2.0)
# ---------------------------------------------------------------------------
# Required before any platform can be connected. Encrypts the access/refresh
# tokens stored in platform_credentials. Generate with:
#   openssl rand -base64 32
# Changing it makes every stored token unreadable — accounts must be reconnected.
SOCIALOS_ENCRYPTION_KEY=""

# The public origin used to build each platform's OAuth callback URL. On Vercel
# this falls back to VERCEL_URL; set it explicitly if you use a custom domain,
# because the value must match the redirect URI registered with each platform.
SOCIALOS_PUBLIC_URL=""

# Per-platform OAuth apps. A platform with no credentials keeps the mock adapter
# and shows its Studio as "not connected" — nothing breaks, it just can't pull.
# Callback URL to register: <SOCIALOS_PUBLIC_URL>/api/oauth/<platform>/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Instagram and Facebook share one Meta app.
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# --- Unified provider (Platform-Connections.md §4) --------------------------
# One provider holds the platform approvals across all five networks, so a user
# connects through a flow that's already been reviewed instead of waiting on
# TikTok's audit queue or Meta's app review. Without a key, UNIFIED is offered
# in Settings but disabled with a reason.
SOCIALOS_UNIFIED_PROVIDER="ayrshare"
AYRSHARE_API_KEY=""
