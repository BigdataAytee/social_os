# ---------------------------------------------------------------------------
# SocialOS environment — see ARCHITECTURE.md §11
# Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Postgres. On Supabase these are the "Connection pooling" and "Direct
# connection" strings from Project Settings → Database.
# For a plain local Postgres, set both to the same value.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialos"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/socialos"

# Supabase Auth — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional. Where new sign-ups land. Set to the seeded demo org's slug and anyone
# who signs up joins a workspace that already has data in it — the fastest way to
# see the app working. Leave empty and each new user gets their own empty
# workspace instead (the normal onboarding path).
SOCIALOS_JOIN_ORG_SLUG="northwind"

# Optional, server-only. Lets prisma/seed.ts create Supabase auth users for the
# five demo people so you can sign in as each role. Not needed if you just sign
# up yourself — SOCIALOS_JOIN_ORG_SLUG puts you in the same org.
SUPABASE_SERVICE_ROLE_KEY=""

# Password given to the seeded demo users. Optional.
SEED_DEMO_PASSWORD="socialos-demo-1234"

# AI orchestrator (ARCHITECTURE.md §9) — not used until Phase 2.
ANTHROPIC_API_KEY=""
